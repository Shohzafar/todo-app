# *args     - arguments
# **kwargs  - keyword arguments


def malumot(**malumotlar):  # { "ism": "Alisher", "yosh": 20, ... }
    for kalit, qiymat in malumotlar.items():
        print(f"{kalit}: {qiymat}")
    print("\n")


